# ==============================================================================
# MEDLEARN VERCEL PRODUCTION ENVIRONMENT CONFIGURATION
# Add these variables in Vercel Dashboard -> Project -> Settings -> Environment Variables
# Apply to: Production, Preview, Development
# ==============================================================================

# 1. Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://iggagkzlvqovfntqbyil.supabase.co

# 2. Supabase Anon / Publishable Key (Public browser key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_zu7N73ni_rI11Yi3U9E2fA_w_XwoWJO
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_zu7N73ni_rI11Yi3U9E2fA_w_XwoWJO

# 3. Application Public URL (Set to your actual Vercel domain once deployed)
# Example: https://medlearn-web.vercel.app or https://medlearn.com
NEXT_PUBLIC_APP_URL=https://<your-project>.vercel.app

# 4. Spring Boot Backend API URL (Optional until backend is hosted)
# Once your Spring Boot backend is hosted (Render / Railway / AWS):
# NEXT_PUBLIC_API_URL=https://<your-backend-service>.onrender.com
# BACKEND_API_URL=https://<your-backend-service>.onrender.com
