# ==============================================================================
# MedLearn Frontend Environment Configuration
# Add these variables to your Vercel Project Settings (Settings -> Environment Variables)
# ==============================================================================

# 1. Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://iggagkzlvqovfntqbyil.supabase.co

# 2. Supabase Anon / Publishable Key (Public browser key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_zu7N73ni_rI11Yi3U9E2fA_w_XwoWJO
# (Alternative alias supported by client.ts)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_zu7N73ni_rI11Yi3U9E2fA_w_XwoWJO

# 3. Application Public URL (Used for Supabase Auth redirect confirmation)
# Local: http://localhost:3000
# Production: https://<your-project>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Spring Boot Backend API URL
# Local: http://localhost:8080
# Production: https://<your-deployed-spring-boot-backend>.onrender.com (or Railway/AWS)
NEXT_PUBLIC_API_URL=http://localhost:8080

# 5. Optional Server-side Backend proxy URL (used by next.config.ts rewrites)
# BACKEND_API_URL=https://<your-deployed-spring-boot-backend>.onrender.com
